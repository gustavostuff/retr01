#!/usr/bin/env bash
# Run the Release sim binary from bin/ (build with ./build-all first).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BIN="$ROOT/bin/sim"
CART="${1:-}"
shift || true

die() { echo "error: $*" >&2; exit 1; }
usage() { echo "usage: ./sim <cart.retr01> [DELAY=typical|max] [--debug]" >&2; exit 2; }

[[ -n "$CART" ]] || usage
[[ -x "$BIN" ]] || die "missing $BIN -- run ./build-all first"

if [[ "$CART" != /* ]]; then
  if [[ -f "$ROOT/$CART" ]]; then
    CART="$ROOT/$CART"
  elif [[ -f "$CART" ]]; then
    CART="$(cd "$(dirname "$CART")" && pwd)/$(basename "$CART")"
  else
    CART="$ROOT/$CART"
  fi
fi
[[ -f "$CART" ]] || die "cart not found: $1"

exec "$BIN" "$CART" "$@"
