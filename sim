#!/usr/bin/env bash
# Retr01 board simulator — one action at a time.
#
# Usage:
#   ./sim build
#   ./sim run [cart.retr01] [-- app-args...]
#   ./sim build-run [cart.retr01] [-- app-args...]
#   ./sim unit
#   ./sim help
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/r01-common.sh
source "$ROOT/scripts/r01-common.sh"

PROJ="$ROOT/retr01_sim"
BIN="$PROJ/build/retr01_sim"
DEFAULT_CART="$ROOT/retr01_studio/test_game/test.retr01"
CMD="${1:-}"
[[ -n "$CMD" ]] || r01_usage_die "usage: $0 <build|run|build-run|unit|help> ..."
shift || true

# Resolve a cart path against the repo root (build-run cds into retr01_sim/).
resolve_cart() {
  local p="$1"
  if [[ "$p" == /* ]]; then
    printf '%s' "$p"
    return
  fi
  if [[ -f "$ROOT/$p" ]]; then
    printf '%s' "$ROOT/$p"
    return
  fi
  if [[ -f "$p" ]]; then
    printf '%s' "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
    return
  fi
  # Prefer ROOT-relative so the binary gets a stable absolute path.
  printf '%s' "$ROOT/$p"
}

# Ensure a cart path is passed to the binary (default: Studio test_game export).
sim_exec() {
  local args=()
  local a
  local has_cart=0
  for a in "$@"; do
    if [[ "$a" != -* ]]; then
      has_cart=1
      args+=("$(resolve_cart "$a")")
    else
      args+=("$a")
    fi
  done
  if [[ $has_cart -eq 0 ]]; then
    exec "$BIN" "${args[@]}" "$DEFAULT_CART"
  else
    exec "$BIN" "${args[@]}"
  fi
}

case "$CMD" in
  help|-h|--help)
    cat <<'EOF'
Retr01 board simulator

  build                 configure (if needed) + build
  run [cart.retr01]     run sim (default: retr01_studio/test_game/test.retr01)
  build-run [cart...]   build then run
  unit                  build + IC unit tests (ctest)
  help                  this text

Cart paths are resolved from the repo root (absolute paths also OK).
EOF
    ;;
  build)
    cd "$PROJ"
    r01_build "$PROJ"
    ;;
  run)
    [[ -x "$BIN" ]] || r01_die "not built — run: $0 build"
    sim_exec "$@"
    ;;
  build-run|br)
    cd "$PROJ"
    r01_build "$PROJ"
    sim_exec "$@"
    ;;
  unit|test)
    cd "$PROJ"
    r01_build "$PROJ"
    r01_ctest "$PROJ" -R '^test_'
    ;;
  *)
    r01_usage_die "unknown command: $CMD (try: $0 help)"
    ;;
esac
