doc-style-rules.txt

# Python (bytecode, venvs, tool caches)
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
.venv/
.venv-*/
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

apps/studio/build/
apps/emu/build/
apps/sim/tier-a/build/
apps/sim/tier-b/build/
apps/sim/tier-h/build/
apps/netlist_sim/build/
bin/
output/
temp/
tools/llvm-mos/
tools/llvm-mos-linux.tar.xz
*.o
*.a
**/r01_custom.so
temp/
apps/sim/tier-a/ui_layout.json
apps/sim/tier-b/ui_layout.json
apps/sim/tier-h/ui_layout.json
apps/sdk/r01_c/build/
apps/sdk/r01_c/host-build/
# Stray Tier H Skidl exports (canonical dir: apps/sim/tier-h/skidl/)
/retr01_tier_h.json
/retr01_prelim.net
/skidl_from_tier_h.*
/skidl_from_tier_h_sklib.py
/skidl.erc
/skidl.log
/skidl_REPL.*
/bad_fmt1.retr01
# Sim layout JSON belongs under apps/sim/*/ (or cwd when testing), not repo root
/ui_layout.json
/test_layout.json

/test_cart.retr01
/test_cart_pb.retr01
/test_prom.bin
/listing.txt
/sdk_overlay.prg
/sdk_overlay.prg.elf
/test_roundtrip.r01proj
.cursor/*.log
.venv-wrl/

# Tier H Skidl export outputs (regenerate: apps/sim/tier-h/skidl/export_netlist.sh)
apps/sim/tier-h/skidl/retr01_prelim.net
apps/sim/tier-h/skidl/retr01_tier_h.json
apps/sim/tier-h/skidl/skidl_from_tier_h_sklib.py
apps/sim/tier-h/skidl/skidl.erc
apps/sim/tier-h/skidl/skidl.log
apps/sim/tier-h/skidl/skidl_REPL.*

# Tier H KiCad project copies (from skidl/library via export_netlist.sh)
apps/sim/tier-h/kicad/main-pcb/v_01/library/
apps/sim/tier-h/kicad/main-pcb/v_01/3dmodels/

# Legacy duplicate of Retr01_Lib.3dshapes (export_netlist.sh optional copy)
apps/sim/tier-h/skidl/library/3dmodels/

# KiCad (local editor / cache; not project source)
# Local History plugin nests its own .git — never track as a submodule (git rm --cached if it appears).
**/.history/
**/.history/**
**/*~
**/*.lck
**/*-backups/
**/fp-info-cache
**/_autosave-*
/build-all
/studio
/emu
/unit-tests
