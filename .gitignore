doc-style-rules.txt

# Python (bytecode, venvs, tool caches)
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
.venv/
.venv-*/
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

apps/studio/build/
apps/emu/build/
apps/sim/build/
apps/tools/discrete_ic/build/
bin/
output/
temp/
apps/tools/llvm-mos/
apps/tools/llvm-mos-linux.tar.xz
*.o
*.a
**/r01_custom.so
temp/
apps/sim/ui_layout.json
apps/sdk/r01_c/build/
apps/sdk/r01_c/host-build/
# Stray Skidl exports (canonical dir: apps/sim/skidl/)
/retr01_sim.json
/retr01_prelim.net
/skidl_netlist.*
/skidl_netlist_sklib.py
/skidl.erc
/skidl.log
/__init__.erc
/__init__.log
/skidl_REPL.*
/bad_fmt1.retr01
# Sim layout JSON belongs under apps/sim/*/ (or cwd when testing), not repo root
/ui_layout.json
/test_layout.json

/test_cart.retr01
/test_cart_pb.retr01
/test_prom.bin
/listing.txt
/sdk_overlay.prg
/sdk_overlay.prg.elf
/test_roundtrip.r01proj
.cursor/*.log
# clangd index
/.cache/
.venv-wrl/

# Skidl export outputs (regenerate: apps/sim/skidl/export_netlist.sh)
apps/sim/skidl/retr01_prelim.net
apps/sim/skidl/retr01_sim.json
apps/sim/skidl/skidl_netlist_sklib.py
apps/sim/skidl/skidl.erc
apps/sim/skidl/skidl.log
apps/sim/skidl/skidl_REPL.*

# KiCad project copies (from skidl/library via export_netlist.sh)
apps/sim/kicad/main-pcb/library/
apps/sim/kicad/main-pcb/3dmodels/

# Legacy duplicate of Retr01_Lib.3dshapes (export_netlist.sh optional copy)
apps/sim/skidl/library/3dmodels/

# KiCad (local editor / cache; not project source)
# Local History plugin nests its own .git — never track as a submodule (git rm --cached if it appears).
**/.history/
**/.history/**
**/*~
**/*.lck
**/*-backups/
**/fp-info-cache
**/_autosave-*
/build-all
/studio
/emu
/unit-tests
/ic_verifier
apps/ic_logic_verifier/*.log
/todos.txt

