Name     upldy_raster ;
PartNo   ATF22V10 ;
Date     2026-09-06 ;
Revision 01 ;
Designer Retr01 ;
Company  Retr01 ;
Assembly None ;
Location UPLDY ;
Device   g22v10 ;

/* Raster compare Y ($FE04) registered inside this PLD.
 * No external Q hop from a discrete latch.
 * P[7:0] = beam Y from UPLDX. Q regs load from CPU D on SEL_FE04.
 * EQ# = (P == Q) active low -> CPU IRQB.
 *
 * pinmap: UPLDY_P, UPLDY_LD, UPLDY_LE_FE04, UPLDY_EQ
 */

PIN 1   = CLK ;
PIN 2   = P0 ;
PIN 3   = P1 ;
PIN 4   = P2 ;
PIN 5   = P3 ;
PIN 6   = P4 ;
PIN 7   = P5 ;
PIN 8   = P6 ;
PIN 9   = P7 ;
PIN 14  = D0 ;
PIN 15  = D1 ;
PIN 16  = D2 ;
PIN 17  = D3 ;
PIN 18  = D4 ;
PIN 19  = D5 ;
PIN 20  = D6 ;
PIN 21  = D7 ;
PIN 22  = EQ ;
PIN 23  = LE_FE04 ;

/* Registered raster Y (internal). Output OE may stay off if unused externally. */
PINNODE  = [Q0..7] ;

Q0.D     = D0 ;
Q0.C     = CLK ;
Q0.CE    = LE_FE04 ;
Q1.D     = D1 ;
Q1.C     = CLK ;
Q1.CE    = LE_FE04 ;
Q2.D     = D2 ;
Q2.C     = CLK ;
Q2.CE    = LE_FE04 ;
Q3.D     = D3 ;
Q3.C     = CLK ;
Q3.CE    = LE_FE04 ;
Q4.D     = D4 ;
Q4.C     = CLK ;
Q4.CE    = LE_FE04 ;
Q5.D     = D5 ;
Q5.C     = CLK ;
Q5.CE    = LE_FE04 ;
Q6.D     = D6 ;
Q6.C     = CLK ;
Q6.CE    = LE_FE04 ;
Q7.D     = D7 ;
Q7.C     = CLK ;
Q7.CE    = LE_FE04 ;

EQ       = !(P0 $ Q0) & !(P1 $ Q1) & !(P2 $ Q2) & !(P3 $ Q3)
         & !(P4 $ Q4) & !(P5 $ Q5) & !(P6 $ Q6) & !(P7 $ Q7) ;

/* TODO: confirm XOR/equality product-term fit. Polarity of EQ# vs IRQB. */
