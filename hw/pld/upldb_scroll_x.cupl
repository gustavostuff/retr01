Name     upldb_scroll_x ;
PartNo   ATF22V10 ;
Date     2026-09-06 ;
Revision 01 ;
Designer Retr01 ;
Company  Retr01 ;
Assembly None ;
Location UPLDB ;
Device   g22v10 ;

/* Registered BG1 scroll X ($FE02).
 * Load enable = SEL_FE02 (from UPLDA) qualified with write (RWB low).
 * Data = CPU D[7:0] on UPLDB_LD pins.
 * Scroll bits stay internal for BG VA generation (equations TBD with interleave).
 *
 * Pin numbers: app/schematic_generator/retr01_schem/pinmap.py
 *   UPLDB_LD[0..7] = pins 2..9
 *   UPLDB_LE_FE02  = pin 23
 *   CLK            = pin 1 (PHI2 or qualified write strobe)
 */

/* Pin declarations (draft names) */
PIN 1   = CLK ;
PIN 2   = D0 ;
PIN 3   = D1 ;
PIN 4   = D2 ;
PIN 5   = D3 ;
PIN 6   = D4 ;
PIN 7   = D5 ;
PIN 8   = D6 ;
PIN 9   = D7 ;
PIN 23  = LE_FE02 ;

/* Registered scroll X (example: clock enable = LE_FE02) */
PIN 14  = SX0 ;
PIN 15  = SX1 ;
PIN 16  = SX2 ;
PIN 17  = SX3 ;
/* Remaining SX4..7 and VRAM/HC245 equations share the rest of the OLMC budget.
 * Fit report required: beam/VRAM glue already uses many product terms.
 */

SX0.D    = D0 ;
SX0.C    = CLK ;
SX0.CE   = LE_FE02 ;
SX1.D    = D1 ;
SX1.C    = CLK ;
SX1.CE   = LE_FE02 ;
SX2.D    = D2 ;
SX2.C    = CLK ;
SX2.CE   = LE_FE02 ;
SX3.D    = D3 ;
SX3.C    = CLK ;
SX3.CE   = LE_FE02 ;

/* TODO: SX4..SX7, CPU_VA / PPU_VA / DIR_OE cart glue from existing board equations. */
