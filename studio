#!/usr/bin/env bash
# retr01 Studio — one action at a time.
#
# Usage:
#   ./studio build
#   ./studio run [-- app-args...]
#   ./studio build-run [-- app-args...]
#   ./studio unit
#   ./studio help
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/r01-common.sh
source "$ROOT/scripts/r01-common.sh"

PROJ="$ROOT/retr01_studio"
BIN="$PROJ/build/retr01_studio"
CMD="${1:-}"
[[ -n "$CMD" ]] || r01_usage_die "usage: $0 <build|run|build-run|unit|help> ..."
shift || true

case "$CMD" in
  help|-h|--help)
    cat <<'EOF'
retr01 Studio

  build              configure (if needed) + build
  run [-- args]      run app (must already be built)
  build-run [-- args]
                     build then run
  unit               build + core unit tests
  help               this text
EOF
    ;;
  build)
    cd "$PROJ"
    r01_build "$PROJ"
    ;;
  run)
    [[ -x "$BIN" ]] || r01_die "not built — run: $0 build"
    exec "$BIN" "$@"
    ;;
  build-run|br)
    cd "$PROJ"
    r01_build "$PROJ"
    exec "$BIN" "$@"
    ;;
  unit|test)
    cd "$PROJ"
    r01_ensure_cmake "$PROJ"
    cmake --build "$PROJ/build" --target test_core
    r01_ctest "$PROJ" -R '^core$'
    ;;
  *)
    r01_usage_die "unknown command: $CMD (try: $0 help)"
    ;;
esac
