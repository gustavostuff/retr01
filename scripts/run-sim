#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=scripts/r01-common.sh
source "$ROOT/scripts/r01-common.sh"

CART="${1:-}"
shift || true
[[ -n "$CART" ]] || r01_usage_die "usage: scripts/run-sim <cart.retr01> [-- sim-args...]"

SIM="$R01_ROOT/retr01_sim"
BIN="$SIM/build/retr01_sim"
CART_ABS="$(r01_resolve_path "$CART")"

[[ -f "$CART_ABS" ]] || r01_die "cart not found: $CART"

r01_build "$SIM"
exec "$BIN" "$CART_ABS" "$@"
