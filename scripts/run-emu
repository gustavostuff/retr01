#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=scripts/r01-common.sh
source "$ROOT/scripts/r01-common.sh"

CART="${1:-}"
[[ -n "$CART" ]] || r01_usage_die "usage: scripts/run-emu <cart.retr01>"

EMU="$R01_ROOT/retr01_emu"
BIN="$EMU/build/retr01_emu"
CART_ABS="$(r01_resolve_path "$CART")"

[[ -f "$CART_ABS" ]] || r01_die "cart not found: $CART"

r01_build "$EMU"
exec "$BIN" "$CART_ABS"
